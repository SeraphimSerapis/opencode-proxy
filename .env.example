UPSTREAM_URL=http://127.0.0.1:4000
UPSTREAM_API_KEY=
PROXY_UPSTREAM_FALLBACK_KEY=
PROXY_HOST=0.0.0.0
PROXY_PORT=9526
LOG_LEVEL=INFO
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=0
UPSTREAM_WRITE_TIMEOUT=30
UPSTREAM_POOL_TIMEOUT=30
UPSTREAM_READY_TIMEOUT=2
# Extra /readyz probe that exercises the upstream engine. /health for vLLM;
# leave unset for LiteLLM, whose /health fans out to every deployment.
UPSTREAM_HEALTH_PATH=
UPSTREAM_STREAM_IDLE_TIMEOUT=30
UPSTREAM_STREAM_FIRST_FRAME_TIMEOUT=480
SSE_KEEPALIVE_INTERVAL=10
UPSTREAM_MAX_RETRIES=2
EMPTY_RESPONSE_RETRIES=1
MAX_CONCURRENT_UPSTREAM=8
STREAM_GUARD_CHARS=192
TOOL_ARGUMENT_CHUNK_SIZE=64
MAX_RAW_TOOL_BLOCK_CHARS=131072
MAX_TOOL_CALLS=32
MAX_TOOL_ARGUMENT_CHARS=262144
TOOL_CALL_SCAN_FIELDS=content,reasoning,reasoning_content
SANITIZE_TOOLS=true
NORMALIZE_REQUESTS=true
REQUEST_DROP_FIELDS=
CUSTOM_HEADERS={"X-Skip-Auth":"true"}
MODEL_ALIASES=dsv4-flash=DeepSeek-V4-Flash,deepseek-ai/DeepSeek-V4-Flash-DSpark=DeepSeek-V4-Flash
ALIAS_CONFLICT_POLICY=skip
PROXY_CONFIG_FILE=
MODALITY_ROUTES=
OLLAMA_VERSION=0.5.1

# Emitted when a turn ends with no content and no tool calls (a reasoning model
# that exhausted max_tokens while thinking). Set empty to disable.
# EMPTY_TURN_NOTICE=
